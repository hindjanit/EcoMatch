# ==============================================================================
# EcoMatch Environment Configuration Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure
# ------------------------------------------------------------------------------
# Required for both client and server Supabase communication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: STRICTLY SERVER-ONLY.
# Required for trust services, Phase 18 background state transitions,
# private storage signing, and cryptographic ledger event commits.
# NEVER expose this key with NEXT_PUBLIC_ prefix!
SUPABASE_SERVICE_ROLE_KEY=

# Optional but strongly recommended for reliable WebRTC audio across mobile
# networks and restrictive NAT/firewalls. Comma-separate multiple TURN URLs.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 2. Artificial Intelligence & Vision Analysis
# ------------------------------------------------------------------------------
# Required for listing trust scoring, photo deduplication, and call audio analysis.
GEMINI_API_KEY=
GEMINI_TRUST_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_FALLBACK_MODEL=gemini-3.7-flash

# Optional: used for secondary price research scraping if configured.
SERPAPI_KEY=

# ------------------------------------------------------------------------------
# 3. Trust, Logistics & Escrow Providers
# ------------------------------------------------------------------------------
# ECOMATCH_DEMO_MODE:
# When set to "true", enables explicitly tagged demo simulations for judges:
# - Simulated delivery tracking progression without real drivers
# - Simulated verified INR payments without payment gateway calls
# When set to "false" (production mode), demo buttons and mock actions are disabled.
ECOMATCH_DEMO_MODE=true

# LOGISTICS_PROVIDER:
# "shiprocket": Real Shiprocket live API delivery and tracking integration.
# "mock": Enabled ONLY when ECOMATCH_DEMO_MODE=true. Simulates quotes & dispatch.
LOGISTICS_PROVIDER=shiprocket

# Shiprocket Live API Configuration (Server-Side Only - NEVER prefix with NEXT_PUBLIC_)
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
# Optional webhook secret for incoming tracking authenticity verification
SHIPROCKET_WEBHOOK_SECRET=

# PAYMENT_PROVIDER:
# "mock": Enabled ONLY when ECOMATCH_DEMO_MODE=true. Simulates payment holds & refunds.
# Any unconfigured provider fails closed with clear, actionable error messages.
PAYMENT_PROVIDER=mock

# ------------------------------------------------------------------------------
# 4. Monetary & Fee Guardrails (Configured in Integer Paise)
# ------------------------------------------------------------------------------
# Percentage markup added to logistics quotes as the EcoMatch platform buffer (Default: 10%)
LOGISTICS_MARKUP_PERCENT=10

# Minimum refundable seller security deposit in paise (50,000 paise = ₹500)
SELLER_DEPOSIT_MIN_PAISE=50000

# Additional risk buffer in paise added to seller deposit (10,000 paise = ₹100)
SELLER_DEPOSIT_RISK_BUFFER_PAISE=10000

# ------------------------------------------------------------------------------
# 5. Deterministic AI Safe Auto-Approval Thresholds
# ------------------------------------------------------------------------------
# Minimum confidence required for safe automated publishing (0.85 = 85%)
AUTO_APPROVE_AI_CONFIDENCE=0.85

